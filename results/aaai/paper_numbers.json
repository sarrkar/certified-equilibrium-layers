  "acceptance_status": {
    "T1": {
      "status": "PASS",
      "reason": "disjoint CCMP per-concept embeddings change at machine zero on real Huesken; the shared-encoder CBM and the Concept Embedding Model leak."
    },
    "T2": {
      "status": "RESTRICTED",
      "reason": "on the real signed/directed TRRUST GRN the rho-based L2 contraction constant is exceeded by directedness non-normality (||S||_2 ~ 8.31 >> rho ~ 1); the inf-norm certificate is non-expansive for every alpha, and the magnetic operator (q-swept) repairs L2 contraction but stays secondary to the real-valued P_alpha."
    },
    "T3": {
      "status": "PASS",
      "reason": "KKT mass-action residual at machine precision on every seed with no accuracy regression; the composed-error bound holds and the IFT gradient through the equality+box ADMM matches finite differences below 1e-6."
    },
